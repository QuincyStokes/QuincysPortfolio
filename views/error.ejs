<div class="error-page">
    <h1><%= typeof message !== 'undefined' ? message : 'Something went wrong' %></h1>
    <p>The page you're looking for couldn't be loaded.</p>
    <a href="/">← Back home</a>
    <% if (typeof error !== 'undefined' && error && error.stack) { %>
        <pre style="margin-top:2rem;font-size:0.8rem;color:var(--text-muted);white-space:pre-wrap;"><%= error.stack %></pre>
    <% } %>
</div>
