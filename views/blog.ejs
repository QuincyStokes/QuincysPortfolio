<div class="page-intro">
    <h1>Blog</h1>
    <p>Thoughts, updates, and insights from my journey in game development and beyond.</p>
</div>

<div class="category-filter">
    <button class="category-btn active" data-category="all">All</button>
    <button class="category-btn" data-category="Game-Dev">Game-Dev</button>
    <button class="category-btn" data-category="Thoughts">Thoughts</button>
    <button class="category-btn" data-category="Life-Updates">Life Updates</button>
</div>

<div class="blog-grid" id="blogGrid">
    <% if (posts && posts.length > 0) { %>
        <% posts.forEach(post => { %>
            <article class="blog-card" data-category="<%= post.category %>">
                <div class="card-category"><%= post.category %></div>
                <h2 class="card-title">
                    <a href="/blog/<%= post.slug %>" class="card-title-link"><%= post.title %></a>
                </h2>
                <p class="card-excerpt"><%= post.excerpt %></p>
                <div class="card-meta">
                    <span class="meta-date"><%= new Date(post.published_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                    <span class="meta-read-time"><%= post.readTime %> min read</span>
                </div>
            </article>
        <% }); %>
    <% } else { %>
        <div class="no-posts">
            <h3>No blog posts yet</h3>
            <p>Check back soon for my first post.</p>
        </div>
    <% } %>
</div>

<% if (hasMore) { %>
    <div class="load-more-container">
        <button class="load-more-btn" id="loadMoreBtn" data-page="<%= currentPage %>">Load more</button>
    </div>
<% } %>

<div class="post-count">
    <p>Showing <%= posts.length %> of <%= totalPosts %> posts</p>
</div>
