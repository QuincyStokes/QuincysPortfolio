<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quincy Stokes - Game Developer</title>
    
    <!-- Apply theme immediately to prevent flash -->
    <script>
        (function() {
            const savedTheme = localStorage.getItem('theme');
            if (savedTheme) {
                document.documentElement.setAttribute('data-theme', savedTheme);
            }
        })();
    </script>
    
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/projects.css">
    <link rel="stylesheet" href="/css/blog.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="preload" href="/images/WorldScreenshot.png" as="image">
</head>
<body>
    <!-- Parallax Background -->
    <div class="parallax-bg"></div>
    
    <!-- Content Overlay -->
    <div class="content-overlay">
        <nav class="navbar">
            <a href="/" class="brand">Quincy Stokes</a>
            <ul class="nav-links">
                <li><a href="/" class="<%= typeof currentPage !== 'undefined' && currentPage === 'home' ? 'active' : '' %>">Home</a></li>
                <li><a href="/projects" class="<%= typeof currentPage !== 'undefined' && currentPage === 'projects' ? 'active' : '' %>">Projects</a></li>
                <li><a href="/blog" class="<%= typeof currentPage !== 'undefined' && currentPage === 'blog' ? 'active' : '' %>">Blog</a></li>
                <li><a href="/contact" class="<%= typeof currentPage !== 'undefined' && currentPage === 'contact' ? 'active' : '' %>">Contact</a></li>
            </ul>
            <!-- Debug: Current page is: <%= typeof currentPage !== 'undefined' ? currentPage : 'undefined' %> -->
            <button class="theme-toggle" id="themeToggle" aria-label="Toggle dark mode">
                <i class="fas fa-moon"></i>
            </button>
        </nav>

        <div class="container">
            <%- body %>
        </div>
    </div>

    <!-- Placeholder for extracted scripts -->
    <%- script %>
    
    <script src="/js/main.js"></script>
    <script src="/js/projects.js"></script>
    <script src="/js/blog.js"></script>
</body>
</html> 